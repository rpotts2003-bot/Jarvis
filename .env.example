# Copy this file to ".env" in this folder (or to %USERPROFILE%\.jarvis\.env)
# Never share this file.

# =============================================================================
# Free-form chat — Jarvis-managed GGUF (NO separate Ollama app required)
# =============================================================================
# On first chat (or first HUD open), Jarvis downloads a small instruct model
# (~1.04 GB) into %USERPROFILE%\.jarvis\models\ and runs it with llama-cpp-python.
# Default: Qwen2.5-1.5B-Instruct Q4_K_M from Hugging Face.
#
# Optional overrides:
# JARVIS_MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-1.5B-Instruct-GGUF/resolve/main/qwen2.5-1.5b-instruct-q4_k_m.gguf
# JARVIS_MODEL_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
# JARVIS_DISABLE_LOCAL_LLM=1

# Built-ins (hi, help, time, date) + PC actions work with no LLM at all.
# How Jarvis addresses you (also: say "call me sir")
JARVIS_ADDRESS_AS=sir

# =============================================================================
# Optional: Ollama (ONLY if you set this — Jarvis does NOT auto-call Ollama)
# =============================================================================
# JARVIS_LOCAL_LLM=1
# JARVIS_LOCAL_MODEL=llama3.2
# JARVIS_OLLAMA_URL=http://127.0.0.1:11434

# =============================================================================
# Optional cloud fallback (only if a key is set — not the default)
# =============================================================================
# Jarvis uses OpenAI-compatible /chat/completions.
#
# --- OpenAI ---
# OPENAI_API_KEY=<openai key>
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# --- Grok (xAI) — get a key at https://console.x.ai/ ---
# OPENAI_API_KEY=<xAI key>
# OPENAI_BASE_URL=https://api.x.ai/v1
# OPENAI_MODEL=grok-3-mini
#
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# Set to 0 to force offline cloud fallback even if a key exists
JARVIS_CLOUD_CHAT=1

# Voice
JARVIS_WAKE_NAME=Jarvis
JARVIS_ALWAYS_LISTEN=1
# Listen uses fixed ~5s window by default. Set JARVIS_VAD=1 for energy-gated capture.
# JARVIS_VAD=0

# Free Windows TTS tuning (British male preference is automatic)
# JARVIS_TTS_RATE=145
# JARVIS_TTS_VOLUME=0.92
# JARVIS_TTS_VOICE=George
