# Copy this file to ".env" in this folder (or to %USERPROFILE%\.jarvis\.env)
# Never share this file.

# =============================================================================
# Free-form chat — prefer LOCAL Ollama (no cloud key)
# =============================================================================
# 1) Install Ollama: https://ollama.com
# 2) Pull a model:   ollama pull llama3.2
# 3) Leave Ollama running (system tray / `ollama serve`)
# 4) Enable below (or leave unset — Jarvis auto-detects :11434)

JARVIS_LOCAL_LLM=1
JARVIS_LOCAL_MODEL=llama3.2
# Optional override (default http://127.0.0.1:11434):
# JARVIS_OLLAMA_URL=http://127.0.0.1:11434
# Or OpenAI-compatible base (Jarvis appends /chat/completions):
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_MODEL=llama3.2

# Built-ins (hi, help, time, date) + PC actions work with no LLM at all.

# =============================================================================
# Optional cloud fallback (only if local is off / unreachable)
# =============================================================================
# Jarvis uses OpenAI-compatible /chat/completions — same env var names for either provider.
#
# --- OpenAI ---
# OPENAI_API_KEY=<openai key>
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# --- Grok (xAI) — get a key at https://console.x.ai/ ---
# OPENAI_API_KEY=<xAI key>
# OPENAI_BASE_URL=https://api.x.ai/v1
# OPENAI_MODEL=grok-3-mini
#
OPENAI_API_KEY=
# Leave BASE_URL empty or pointed at Ollama when using local; cloud examples above.
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=llama3.2
# Set to 0 to force offline chat even if a cloud key exists
JARVIS_CLOUD_CHAT=1

# Voice
JARVIS_WAKE_NAME=Jarvis
JARVIS_ALWAYS_LISTEN=1
# Listen uses fixed ~5s window by default. Set JARVIS_VAD=1 for energy-gated capture.
# JARVIS_VAD=0

# Free Windows TTS tuning (British male preference is automatic)
# JARVIS_TTS_RATE=145
# JARVIS_TTS_VOLUME=0.92
# JARVIS_TTS_VOICE=George
